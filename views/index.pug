extends layout
include product_display.pug

block links 
  link(rel='stylesheet', href='/stylesheets/Product_Display_Style.css')
  link(rel='stylesheet', href='/stylesheets/Homepage_Style.css')

block content
  main.page-content
    h1.page-title Featured Items
    ul.product-list
      each product in featuredProducts
        +product_display(product)
  footer.order-services
    p Order Now!
    a.order-link(href="https://www.doordash.com/") DoorDash
    a.order-link(href="https://www.grubhub.com/") GrubHub

