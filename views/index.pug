extends layout

block styles 
  link(rel='stylesheet', href='/stylesheets/homePageStyle.css')

block content
  div.page-content
    h1.page-title Featured Items
    ul.product-list
      each product in featuredProducts
        li.product-display
          img.product-image(src= product_image)
          p= product.product_name + " - $" + product.price

