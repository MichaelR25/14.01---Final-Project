mixin reviewLayout(product, page_type)
    section.reviews
        h1= `${page_type} Reviews`
        p Please leave a Review!
        form#review-form
            label(for="user-name-input") Enter a username: 
                input#user-name-input(type="text" name="userName") 
            fieldset.review-rating
                legend Click to leave a rating!
                label(for="one-star") 
                    input#one-star(type="radio" name="rating" value=1)
                    | 1 Star
                label(for="two-stars") 
                    input#two-stars(type="radio" name="rating" value=2)
                    | 2 Stars
                label(for="three-stars") 
                    input#three-stars(type="radio" name="rating" value=3)
                    | 3 Stars
                label(for="four-stars") 
                    input#four-stars(type="radio" name="rating" value=4)
                    | 4 Stars
                label(for="five-stars") 
                    input#five-stars(type="radio" name="rating" value=5 checked)
                    | 5 Stars
            
            label.review-text-label(for="review-text") Write a Review (Optional):
                textarea#review-text(name="reviewText")
            if product
                input#id(type="hidden" name="id" value=product.product_id)
            p.hidden#error-box Error: 
            input(type="Submit" value="Submit") 
            
        if reviews.length == 0 
            p No reviews Yet!
        each review in reviews
            div.user-reviews
                h1.review-name-and-date= review.user_name + " on " + review.review_date.toDateString()
                p.review-content= review.review_content
                p.review-rating= `Rating: ${review.rating} Stars`

        div.page-buttons
            if current_page > 1 
                a.change-page(href=`?page=${previous_page}`) Previous Page
            else
                p.change-page Previous Page

            p.change-page= `Page: ${current_page} of ${max_pages}`
            
            if current_page < max_pages
                a.change-page(href=`?page=${next_page}`) Next Page
            else
                p.change-page Next Page