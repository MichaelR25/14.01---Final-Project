extends layout
include product_display.pug

block links 
  link(rel='stylesheet', href='/stylesheets/Product_Display_Style.css')
  link(rel='stylesheet', href='/stylesheets/Menu_Style.css')
  script(src='/javascripts/Menu_Page_Buttons.js' defer)
block content
    main.page-content
        h1.page-title Menu
        button#show-filters.hidden Filters
        form#filter-form.hidden.form-style
            fieldset 
                legend Filter by: 
                label(for="donut-filter")
                    input#donut-filter(type="checkbox" name="category"  value="donut" checked)
                    | Single Donuts
                label(for="box-filter") 
                    input#box-filter(type="checkbox" name="category" value="box" checked)
                    | Boxes
                label(for="coffee-filter")
                    input#coffee-filter(type="checkbox" name="category" value="coffee" checked)
                    | Coffee
            
        ul.product-list
            each product in featuredProducts
                +product_display(product)

