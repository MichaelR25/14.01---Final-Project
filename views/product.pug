extends layout

block styles 
    link(rel='stylesheet', href='../stylesheets/Product_Page_Style.css')

block content
    div.product-showcase
        img.product-img(src=product.product_image)
        div.product-text
            h1.product-name= product.product_name
            p.product-description= product.product_description

    div.reviews
        h1 Reviews
        button#add-review-button Add Review
        form#review-form
            fieldset.review-rating
                legend Click to leave a rating!
                label#one-star(for="rating") 
                    input(type="radio" name="rating" value=1)
                    | 1 Star
                label#two-stars(for="rating") 
                    input(type="radio" name="rating" value=2)
                    | 2 Stars
                label#three-stars(for="rating") 
                    input(type="radio" name="rating" value=3)
                    | 3 Stars
                label#four-stars(for="rating") 
                    input(type="radio" name="rating" value=4)
                    | 4 Stars
                label#five-stars(for="rating") 
                    input(type="radio" name="rating" value=5)
                    | 5 Stars

            label(for="review-text") Write a Review:
                textarea#review-text(name="review-text")
            input(type="Submit" value="Submit") 
            
        if reviews.length == 0 
            p No reviews Yet!
        each review in reviews
            div.user-reviews
                p= review.user_name + " " + review.review_date.toDateString()
                p= review.review_content
                p= `Rating: ${review.rating} Stars`